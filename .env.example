# Local demo only. Do not commit a filled .env file.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
DATABASE_PATH=./data/radar.sqlite
PUBLIC_BASE_URL=http://localhost:8787

# Defaults intentionally rejected by production-mode validation.
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret

# Network collection stays OFF until deliberately configured.
ENABLE_BACKGROUND_POLLING=false
POLL_INTERVAL_SECONDS=300
TELEGRAM_BOT_POLLING=false
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
GUARDIAN_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
STORE_FULL_TEXT=false
