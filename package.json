{
  "name": "iran-war-radar-server",
  "version": "1.0.0",
  "private": true,
  "description": "Secure news aggregation API for Iran War Radar",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test-runner.mjs",
    "seed": "tsx scripts/seed.ts",
    "telegram:login": "tsx scripts/telegram-login.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
